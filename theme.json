{
  "$schema": "https://schemas.wp.org/wp/6.5/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultDuotone": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "base",           "color": "#f9f9f9", "name": "Base" },
        { "slug": "base-2",         "color": "#ffffff", "name": "Base / Two" },
        { "slug": "contrast",       "color": "#111111", "name": "Contrast" },
        { "slug": "contrast-2",     "color": "#636363", "name": "Contrast / Two" },
        { "slug": "contrast-3",     "color": "#A4A4A4", "name": "Contrast / Three" },
        { "slug": "accent",         "color": "#cfcabe", "name": "Accent" },
        { "slug": "accent-2",       "color": "#c2a990", "name": "Accent / Two" },
        { "slug": "accent-3",       "color": "#d8613c", "name": "Accent / Three" },
        { "slug": "accent-4",       "color": "#b1c5a4", "name": "Accent / Four" },
        { "slug": "accent-5",       "color": "#b5bdbc", "name": "Accent / Five" },
        { "slug": "custom-text-light",    "color": "#9c9c9c", "name": "Text Light" },
        { "slug": "custom-border-light",  "color": "#eaeaea", "name": "Border Light" },
        { "slug": "custom-link-alt",      "color": "#0f25d1", "name": "Link Alt" }
      ]
    },
    "layout": {
      "contentSize": "714px",
      "wideSize": "1280px"
    },
    "spacing": {
      "spacingSizes": [
        { "slug": "10", "size": "1rem",                          "name": "1" },
        { "slug": "20", "size": "min(1.5rem, 2vw)",              "name": "2" },
        { "slug": "30", "size": "min(2.5rem, 3vw)",              "name": "3" },
        { "slug": "40", "size": "min(4rem, 5vw)",                "name": "4" },
        { "slug": "50", "size": "min(6.5rem, 8vw)",              "name": "5" },
        { "slug": "60", "size": "min(10.5rem, 13vw)",            "name": "6" }
      ],
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "\"Inter\", sans-serif",
          "fontFace": [
            { "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "300 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/inter-latin-variable-full-normal.woff2"] }
          ]
        },
        {
          "slug": "heading",
          "name": "Heading",
          "fontFamily": "Cardo, serif",
          "fontFace": [
            { "fontFamily": "Cardo", "fontStyle": "normal",  "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/cardo-latin-400-normal.woff2"] },
            { "fontFamily": "Cardo", "fontStyle": "italic",  "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/cardo-latin-400-italic.woff2"] },
            { "fontFamily": "Cardo", "fontStyle": "normal",  "fontWeight": "700", "fontDisplay": "swap", "src": ["file:./assets/fonts/cardo-latin-700-normal.woff2"] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small",    "size": "0.9rem",  "name": "Small" },
        { "slug": "medium",   "size": "1.05rem", "name": "Medium" },
        { "slug": "large",    "size": "clamp(1.39rem, 1.39rem + ((1vw - 0.2rem) * 0.767), 1.85rem)", "name": "Large" },
        { "slug": "x-large",  "size": "clamp(1.85rem, 1.85rem + ((1vw - 0.2rem) * 1.083), 2.5rem)", "name": "X Large" },
        { "slug": "xx-large", "size": "clamp(2.5rem, 2.5rem + ((1vw - 0.2rem) * 1.283), 3.27rem)",  "name": "XX Large" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "fontStyle": "normal",
      "fontWeight": "400",
      "lineHeight": "1.55"
    },
    "spacing": {
      "blockGap": "1.2rem",
      "padding": {
        "left": "var(--wp--preset--spacing--50)",
        "right": "var(--wp--preset--spacing--50)"
      }
    },
    "elements": {
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.15", "fontFamily": "var(--wp--preset--font-family--heading)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)",  "fontFamily": "var(--wp--preset--font-family--heading)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)",    "fontFamily": "var(--wp--preset--font-family--heading)" } },
      "h4": { "typography": { "fontSize": "clamp(1.1rem, 1.1rem + ((1vw - 0.2rem) * 0.767), 1.5rem)", "fontFamily": "var(--wp--preset--font-family--heading)" } },
      "h5": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)",   "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "600" } },
      "h6": { "typography": { "fontSize": "var(--wp--preset--font-size--small)",    "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "600" } },
      "link": {
        "color": { "text": "var(--wp--preset--color--custom-link-alt)" },
        "typography": { "textDecoration": "underline" },
        ":hover": { "color": { "text": "var(--wp--preset--color--custom-link-alt)" }, "typography": { "textDecoration": "none" } }
      },
      "button": {
        "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast-2)" },
        "border": { "radius": "8px", "color": "var(--wp--preset--color--base)" },
        "spacing": { "padding": { "top": "0.6rem", "right": "1rem", "bottom": "0.6rem", "left": "1rem" } },
        "typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "400", "fontStyle": "normal" },
        ":hover": { "color": { "background": "#efefef", "text": "var(--wp--preset--color--contrast-2)" }, "border": { "color": "#efefef" } }
      }
    },
    "blocks": {
      "core/image": {
        "border": { "radius": "8px" }
      },
      "core/gallery": {
        "border": { "radius": "8px" }
      },
      "core/video": {
        "border": { "radius": "8px" }
      },
      "core/embed": {
        "border": { "radius": "8px" }
      },
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "clamp(0.875rem, 0.875rem + ((1vw - 0.2rem) * 0.542), 1.2rem)",
          "fontWeight": "600",
          "letterSpacing": "-0.01em"
        },
        "elements": {
          "link": {
            "color": { "text": "var(--wp--preset--color--contrast)" },
            "typography": { "textDecoration": "none" },
            ":hover": { "typography": { "textDecoration": "none" } }
          }
        }
      },
      "core/post-date": {
        "color": { "text": "var(--wp--preset--color--contrast-2)" },
        "typography": { "fontSize": "var(--wp--preset--font-size--small)" },
        "elements": {
          "link": {
            "color": { "text": "var(--wp--preset--color--contrast-2)" },
            "typography": { "textDecoration": "none" },
            ":hover": { "typography": { "textDecoration": "underline" } }
          }
        }
      }
    }
  }
}
